# Variables de entorno de PlatAnt.
#
# Copia este archivo como ".env.local" y llena los valores. El archivo
# ".env.local" nunca se sube al repositorio.

# --- Supabase (base de datos y cuentas) ---
# Están en el panel de Supabase: Project Settings → API Keys.
# Estas dos son públicas: llegan al navegador y no dan acceso a datos por sí solas.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clave secreta: salta la seguridad por fila. Solo la usa el servidor (para crear cuentas).
# Nunca la compartas ni la pongas en una variable que empiece por NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Conexión directa a la base de datos. Solo sirve para aplicar las migraciones (pnpm db:push);
# la app nunca la usa. Está en el panel: Connect → Session pooler.
# Si la contraseña tiene símbolos, van codificados como URL (por ejemplo, @ es %40).
SUPABASE_DB_URL=postgresql://postgres.tu-proyecto:CONTRASEÑA@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# --- Registro de cuentas nuevas ---
# "true" lo abre. Cualquier otro valor, o no ponerla, lo deja cerrado.
REGISTRATION_OPEN=false
